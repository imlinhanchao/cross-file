#!/usr/bin/env node
// CrossFile mobile — Gradle/Android-Studio bridge for the Tauri CLI.
//
// The Android project generated by `tauri android init` contains a Gradle
// `rust` plugin whose BuildTask runs `node tauri android android-studio-script`
// with this directory (`src-tauri/`) as the working directory. Node resolves the
// bare `tauri` script relative to that cwd, so this forwarder is what lets the
// Gradle plugin find the real CLI in the pnpm workspace root `node_modules`.
// See docs/mobile.md §2.3.
//
// Used only by Gradle / Android Studio; the normal
// `pnpm --filter @crossfile/mobile android:build` entry point is unaffected.
//
// Note: apps/mobile/package.json sets "type": "module", so this file is ESM and
// has to load the CommonJS CLI through createRequire.
import { createRequire } from 'node:module'

const require = createRequire(import.meta.url)
require('../../../node_modules/@tauri-apps/cli/tauri.js')
