# CrossFile self-hosting configuration (copy to infra/.env, never commit it).
#
#   cp infra/.env.example infra/.env
#   # generate a fresh TURN secret:
#   openssl rand -hex 32
#
# docker compose reads infra/.env because it sits next to infra/docker-compose.yml.
# Everything here is public except TURN_SECRET.
#
# One container runs the Go single binary: web app + `/v1/ws` + in-process TURN. There is no
# separate coturn service and no Node runtime (docs/self-host.md).

# Shared secret for ephemeral TURN credentials (docs/02 §6.7): the same secret signs the
# HMAC-SHA1 credentials handed to browsers and authenticates the TURN listener. TURN starts
# only when TURN_SECRET and TURN_URIS are both non-empty; leave TURN_URIS empty for a
# direct-connection-only instance (TURN_SECRET is then unused).
TURN_SECRET=replace-with-openssl-rand-hex-32

# What the *browser* is told. Use the public hostname/IP of this machine, not 127.0.0.1, unless
# the browser runs on the same host (then turn:127.0.0.1:3478 works for local tests).
# Comma-separated; udp and tcp variants are both listed so the browser can fall back.
TURN_URIS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Public hostname used by the reverse proxy / docs (not read by the services themselves).
PUBLIC_HOST=room.example.com

# Address that TURN relay candidates advertise. On a VPS put the public IPv4; for two browsers on
# this machine 127.0.0.1 works; for a phone on the same Wi-Fi use the host's LAN IP.
# Required whenever TURN_URIS/TURN_SECRET enable TURN.
TURN_EXTERNAL_IP=127.0.0.1

# Host port for the TURN listener (3478 is the standard unencrypted TURN port) and the UDP relay
# allocation range. The published range must equal the container's TURN_MIN/MAX_PORT because
# relay ports are advertised to browsers.
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Interface to publish signaling + TURN on. 0.0.0.0 is fine behind a firewall/reverse proxy.
TURN_BIND=0.0.0.0

# Host port for signaling. 8788 matches the repository's dev default (`pnpm dev` and the Vite
# proxy both use 8788), so `pnpm dev:web` + this compose file share the same dev origin.
# The container itself always listens on 8787; only the published host port changes here.
SIGNAL_PORT=8788
# Interface to publish on. 0.0.0.0 is fine behind a firewall/reverse proxy; 127.0.0.1 keeps the
# signaling port private when the reverse proxy runs on the same host.
SIGNAL_BIND=127.0.0.1

# Room capacity excluding the admin (docs/01 D6). Official instance: 2. Self-hosted default: 4.
# MAX_MEMBERS=2
