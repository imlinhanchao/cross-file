{
  "name": "crossfile",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @crossfile/web dev",
    "dev:signal": "SKIP_WEB=1 bash apps/signaling-go/build.sh && PORT=8788 HOST=127.0.0.1 apps/signaling-go/bin/crossfile-signaling",
    "build": "pnpm --filter @crossfile/web build",
    "build:signal": "bash apps/signaling-go/build.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "gate:contrast": "node design/tools/check-contrast.mjs",
    "gate:colors": "bash scripts/check-hardcoded-colors.sh",
    "gate": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm gate:contrast && pnpm gate:colors",
    "build:desktop": "pnpm --filter @crossfile/desktop build",
    "dev:desktop-electron": "electron apps/desktop-electron"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@noble/hashes": "^2.0.1",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  }
}
